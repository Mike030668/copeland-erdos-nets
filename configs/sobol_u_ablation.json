{
  "experiment": {
    "name": "r004_sobol_u_ablation",
    "description": "Sobol-U vs Sobol-N ablation"
  },
  "data": {
    "batch_size": 256,
    "num_workers": 0,
    "dataset": "MNIST"
  },
  "training": {
    "optimizer": "sgd",
    "lr": 0.05,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "epochs": 20,
    "scheduler": "cosine",
    "device": "auto"
  },
  "evaluation": {
    "metrics": [
      "accuracy",
      "loss"
    ],
    "convergence_threshold": 0.97,
    "extended_metrics": true
  },
  "model": {
    "type": "mlp",
    "hidden_sizes": [
      256,
      128
    ],
    "activation": "relu",
    "dropout": 0.0,
    "batch_norm": false
  },
  "runs": [
    {
      "init_method": "sobol_n",
      "init_params": {
        "scramble_seed": 0,
        "mode": "normal"
      }
    },
    {
