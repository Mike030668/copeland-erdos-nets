{
  "experiment": {
    "name": "mnist_deep_mlp",
    "seed_range": [42, 43, 44, 45, 46]
  },
  "data": {
    "dataset": "MNIST",
    "batch_size": 128,
    "num_workers": 0
  },
  "models": {
    "deep_mlp": {
      "type": "MLP",
      "hidden_sizes": [512, 512, 256, 128],
      "activation": "relu",
      "dropout": 0.0
    }
  },
  "init_methods": [
    {"name": "he"},
    {"name": "xavier"},
    {"name": "sobol_n", "kind": "he", "scramble_seeds": [0, 1, 2, 3, 4]},
    {"name": "ce_n", "kind": "he", "m": 6, "offsets": [0, 10000, 50000, 100000, 500000]},
    {"name": "ce_n", "kind": "he", "m": 8, "offsets": [0, 10000, 50000]}
  ],
  "training": {
    "epochs": 15,
    "optimizer": "adam",
    "lr": 0.001,
    "device": "auto"
  },
  "evaluation": {
    "metrics": ["accuracy", "loss"],
    "convergence_threshold": 0.97
  }
}
