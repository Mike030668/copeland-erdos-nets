{
  "experiment": {
    "name": "R006a_mixer_screening_trial",
    "seed_range": [42],
    "datasets": ["FashionMNIST", "CIFAR10"]
  },
  "data": {
    "batch_size": 128
  },
  "model": {
    "patch_size": 4,
    "num_blocks": 2,
    "hidden_dim": 128,
    "token_dim": 64,
    "channel_dim": 128
  },
  "init_methods": [
    {
      "name": "xavier"
    },
    {
      "name": "he"
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0],
      "params": {
        "assignment": "sequential"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0],
      "params": {
        "assignment": "shuffled"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0],
      "params": {
        "assignment": "hash_indexed"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0],
      "params": {
        "assignment": "prime_stride"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0],
      "params": {
        "assignment": "lcg"
      }
    },
    {
      "name": "sobol_n",
      "kind": "he",
      "scramble_seeds": [0],
      "params": {
        "assignment": "sequential",
        "matrix_shaped": false
      }
    },
    {
      "name": "sobol_n",
      "kind": "he",
      "scramble_seeds": [0],
      "params": {
        "assignment": "shuffled",
        "matrix_shaped": false
      }
    }
  ],
  "training": {
    "epochs": 2,
    "optimizer": "adam",
    "lr": 0.001,
    "device": "auto",
    "cooldown_seconds": 1,
    "thermal_threshold": 75
  },
  "evaluation": {
    "metrics": ["accuracy"],
    "convergence_threshold": 0.97
  }
}
