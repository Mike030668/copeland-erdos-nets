{
  "experiment": {
    "name": "R011_embedding_init_factorial_ablation_colab_smoke",
    "mode": "r011_factorial_smoke",
    "seed": 42
  },
  "data": {
    "dataset": "Salesforce/wikitext",
    "config_name": "wikitext-2-raw-v1",
    "tokenizer": "gpt2",
    "batch_size": 32,
    "seq_len": 128,
    "train_drop_last": true,
    "val_drop_last": true,
    "test_drop_last": false
  },
  "model": {"d_model": 128, "n_heads": 4, "d_ff": 512, "n_layers": 2},
  "training": {"epochs": 1, "lr": 5e-4, "weight_decay": 0.01, "device": "auto"},
  "init": {"ce_m": 8, "ce_offset_blocks": 0}
}
