{
  "experiment": {
    "name": "R007_transformer_screening",
    "seed_range": [42, 43, 44, 45, 46],
    "datasets": ["WikiText2"]
  },
  "data": {
    "batch_size": 32,
    "seq_len": 128
  },
  "model": {
    "d_model": 128,
    "n_heads": 4,
    "d_ff": 512,
    "n_layers": 2,
    "vocab_size": 50257
  },
  "init_methods": [
    {
      "name": "xavier"
    },
    {
      "name": "he"
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "sequential"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "shuffled"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "hash_indexed"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "prime_stride"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "lcg"
      }
    },
    {
      "name": "sobol_n",
      "kind": "he",
      "scramble_seeds": [0, 1, 2, 3, 4],
      "params": {
        "assignment": "sequential",
        "matrix_shaped": false
      }
    },
    {
      "name": "sobol_n",
      "kind": "he",
      "scramble_seeds": [0, 1, 2, 3, 4],
      "params": {
        "assignment": "shuffled",
        "matrix_shaped": false
      }
    }
  ],
  "training": {
    "epochs": 15,
    "optimizer": "adamw",
    "lr": 0.0005,
    "device": "auto",
    "cooldown_seconds": 5,
    "thermal_threshold": 81
  },
  "evaluation": {
    "metrics": ["loss", "perplexity"]
  }
}
