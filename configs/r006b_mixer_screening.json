{
  "experiment": {
    "name": "R006b_mixer_screening",
    "seed_range": [42, 43, 44, 45, 46],
    "datasets": ["FashionMNIST", "CIFAR10"]
  },
  "data": {
    "batch_size": 128
  },
  "model": {
    "patch_size": 4,
    "num_blocks": 2,
    "hidden_dim": 128,
    "token_dim": 64,
    "channel_dim": 128
  },
  "init_methods": [
    {
      "name": "xavier"
    },
    {
      "name": "he"
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "sequential"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "shuffled"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "hash_indexed"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "prime_stride"
      }
    },
    {
      "name": "ce_n",
      "kind": "he",
      "m": 8,
      "offsets": [0, 10000, 50000, 100000, 500000],
      "params": {
        "assignment": "lcg"
      }
    },
    {
      "name": "sobol_n",
      "kind": "he",
      "scramble_seeds": [0, 1, 2, 3, 4],
      "params": {
        "assignment": "sequential",
        "matrix_shaped": false
      }
    },
    {
      "name": "sobol_n",
      "kind": "he",
      "scramble_seeds": [0, 1, 2, 3, 4],
      "params": {
        "assignment": "shuffled",
        "matrix_shaped": false
      }
    }
  ],
  "training": {
    "epochs": 15,
    "optimizer": "adam",
    "lr": 0.001,
    "device": "auto",
    "cooldown_seconds": 5,
    "thermal_threshold": 75
  },
  "evaluation": {
    "metrics": ["accuracy"],
    "convergence_threshold": 0.97
  }
}
