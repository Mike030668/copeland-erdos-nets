{
  "experiment": {
    "name": "r004_mlp4_extended",
    "description": "MLP-4 extended metrics"
  },
  "data": {
    "batch_size": 256,
    "num_workers": 0,
    "dataset": "MNIST"
  },
  "training": {
    "optimizer": "sgd",
    "lr": 0.05,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "epochs": 20,
    "scheduler": "cosine",
    "device": "auto"
  },
  "evaluation": {
    "metrics": [
      "accuracy",
      "loss"
    ],
    "convergence_threshold": 0.97,
    "extended_metrics": true
  },
  "model": {
    "type": "mlp",
    "hidden_sizes": [
      512,
      512,
      256,
      128
    ],
    "activation": "relu",
