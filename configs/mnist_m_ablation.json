{
  "experiment": "mnist_m_ablation",
  "data": {
    "dataset": "MNIST",
    "batch_size": 128,
    "num_workers": 0
  },
  "models": {
    "mlp": {
      "type": "MLP",
      "hidden_sizes": [256, 128],
      "activation": "relu",
      "dropout": 0.0
    }
  },
  "init_methods": [
    {"name": "ce_n", "kind": "he", "m": 3},
    {"name": "ce_n", "kind": "he", "m": 4},
    {"name": "ce_n", "kind": "he", "m": 5},
    {"name": "ce_n", "kind": "he", "m": 6},
    {"name": "he"}
  ],
  "training": {
    "epochs": 15,
    "optimizer": "adam",
    "lr": 0.001,
    "device": "cpu"
  },
  "evaluation": {
    "metrics": ["accuracy", "loss"],
    "convergence_threshold": 0.97
  }
}
