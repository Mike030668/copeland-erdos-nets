{
  "experiment": {"name": "r004_deep_mlp", "seed_range": [42, 43, 44, 45, 46]},
  "data": {"dataset": "MNIST", "batch_size": 256, "num_workers": 0},
  "models": {
    "deep_mlp": {
      "type": "deep_mlp",
      "hidden_sizes": [512, 512, 256, 128],
      "activation": "relu",
      "dropout": 0.0
    }
  },
  "init_methods": [
    {"name": "ce_n", "kind": "he", "m": 8, "offsets": [0, 1000, 10000, 100000, 1000000]},
    {"name": "ce_u", "kind": "he", "m": 8, "offsets": [0, 1000, 10000, 100000, 1000000]},
    {"name": "sobol_n", "kind": "he", "scramble_seeds": [0, 1, 2, 3, 4]},
    {"name": "sobol_u", "kind": "he", "scramble_seeds": [0, 1, 2, 3, 4]},
    {"name": "he"},
    {"name": "xavier"}
  ],
  "training": {
    "epochs": 15, "optimizer": "adam", "lr": 0.001, "device": "auto"
  },
  "evaluation": {
    "metrics": ["accuracy", "loss"],
    "convergence_threshold": 0.97
  }
}
